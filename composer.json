{
    "name": "chapterjason/websocket-bundle",
    "description": "Symfony integration for the FrankenPHP WebSocket extension",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "websocket",
        "frankenphp"
    ],
    "authors": [
        {
            "name": "Jason Schilling",
            "email": "jason.schilling@hotmail.de"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.0",
        "phrity/websocket": "^4.1",
        "symfony/console": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/security-bundle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Chapterjason\\WebsocketBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chapterjason\\WebsocketBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test:e2e": "scripts/e2e.sh"
    }
}
